* text=auto
.gitattributes text eol=lf
.gitignore text eol=lf
*.json text eol=lf
*.v text eol=lf
*.vhd text eol=lf
*.tcl text eol=lf
*.cfg text eol=lf
*.al text eol=lf
*.adc text eol=lf
*.sdc text eol=lf
*.py text eol=lf
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.md text eol=lf
*.zip binary
*.whl binary
*.bit binary
*.img binary
*.bin binary
*.enc.v binary
*.pdf binary
*.xlsx binary
*.png binary
*.area -text -whitespace
*.timing -text -whitespace
*.mkv binary
# Preserve the submission snapshot byte-for-byte, including manifest hashes.
/up-projuct/** -text !eol
